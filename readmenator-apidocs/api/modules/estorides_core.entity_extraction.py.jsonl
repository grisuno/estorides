{"uid":"estorides_core/entity_extraction.py::extract_from_text","name":"extract_from_text","qualname":"extract_from_text","kind":"function","file":"estorides_core/entity_extraction.py","line":146,"end_line":197,"language":"py","signature":"def extract_from_text(text: str, source: str, *, types: Optional[List[str]] = None) -> List[Entity]","params":[{"name":"text","annotation":"str","default":"","kind":"positional"},{"name":"source","annotation":"str","default":"","kind":"positional"},{"name":"types","annotation":"Optional[List[str]]","default":"None","kind":"keyword_only"}],"returns":"List[Entity]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Find every recognised entity in a raw text blob.","description":"`types` optionally restricts which kinds of entity to look for.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_extraction.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/entity_extraction.py::Entity"],"called_by":["estorides_core/entity_extraction.py::extract_from_json"]}
{"uid":"estorides_core/entity_extraction.py::extract_from_json","name":"extract_from_json","qualname":"extract_from_json","kind":"function","file":"estorides_core/entity_extraction.py","line":210,"end_line":234,"language":"py","signature":"def extract_from_json(payload: Any, source: str, *, types: Optional[List[str]] = None) -> List[Entity]","params":[{"name":"payload","annotation":"Any","default":"","kind":"positional"},{"name":"source","annotation":"str","default":"","kind":"positional"},{"name":"types","annotation":"Optional[List[str]]","default":"None","kind":"keyword_only"}],"returns":"List[Entity]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Pull entities out of a JSON-like structure.","description":"Earlier this recursed into every string and ran all patterns on each one,\nso a response with thousands of entries (crt.sh subdomains, wayback URLs)\ntriggered hundreds of thousands of regex passes. We now flatten the payload\nto a single capped string and scan it once; entities span keys and values\njust as well, and the cost is bounded by `extract_from_text`.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_extraction.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/entity_extraction.py::extract_from_text"],"called_by":["estorides_core/orchestrator.py::Orchestrator.run"]}
{"uid":"estorides_core/entity_extraction.py::extract_structured","name":"extract_structured","qualname":"extract_structured","kind":"function","file":"estorides_core/entity_extraction.py","line":330,"end_line":379,"language":"py","signature":"def extract_structured(payload: Any, source: str) -> List[Entity]","params":[{"name":"payload","annotation":"Any","default":"","kind":"positional"},{"name":"source","annotation":"str","default":"","kind":"positional"}],"returns":"List[Entity]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Extract human selectors (email, username, person, org, phone) by key.","description":"Walks the JSON structure and types values by the key they sit under,\nwhich is the only reliable way to recover usernames and person names\n(they have no lexical signature for a regex to catch). Bounded by\n`ENTITY_MAX_PER_TYPE` per type and a node-visit cap so a pathological\nresponse cannot turn this into a CPU stall.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_extraction.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/entity_extraction.py::Entity"],"called_by":["estorides_core/orchestrator.py::Orchestrator.run"]}
{"uid":"estorides_core/entity_extraction.py::merge","name":"merge","qualname":"merge","kind":"function","file":"estorides_core/entity_extraction.py","line":382,"end_line":467,"language":"py","signature":"def merge(*entity_lists: Iterable[Entity], fuzzy: bool = True) -> List[Entity]","params":[{"name":"*entity_lists","annotation":"Iterable[Entity]","default":"","kind":"var_positional"},{"name":"fuzzy","annotation":"bool","default":"True","kind":"keyword_only"}],"returns":"List[Entity]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Deduplicate by (type, value) and merge sources / contexts.","description":"Two entities with the same (type, value) collapse into a single\nrecord. Their `sources` lists are unioned (preserving the first\nseen order), `context` is concatenated up to a 200-char window,\nand `confidence` is bumped by 0.1 for each extra observation\n(capped at 1.0) — a simple \"corroboration bonus\".\n\nThe `sources` field is the canonical \"all the places this was\nseen\" record. The previous implementation stored it in a\nprivate attribute (`_src`) that was never serialised and broke\n`asdict()` (TypeError on `dataclasses.asdict` for non-dataclass\nattributes). This version is a real, declared field.\n\nv1.1: After exact-key dedup, run a second pass with\n`difflib.SequenceMatcher` to catch near-misses like\n`EvilCorp.com` vs `evil-corp.com`. Anything above the\n`FUZZY_THRESHOLD` ratio collapses into a single record.\nReturns the deduped list, with cluster groups available via\n`fuzzy_clusters` if the caller wants them.\n\nv1.4: pass ``fuzzy=False`` to do exact-key dedup only. The\norchestrator does this when the canonical identity layer\n(`entity_resolution`) is active, so the resolver owns every fuzzy\ndecision instead of inheriting a coarser difflib pre-merge that would,\nfor example, silently fuse two distinct domain registrations the\nresolver intends to keep separate and merely *link*.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_extraction.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/entity_extraction.py::Entity"],"called_by":["estorides_core/orchestrator.py::Orchestrator.run","static/js/estorides.js::drawHulls"]}
{"uid":"estorides_core/entity_extraction.py::FUZZY_THRESHOLD","name":"FUZZY_THRESHOLD","qualname":"FUZZY_THRESHOLD","kind":"constant","file":"estorides_core/entity_extraction.py","line":473,"end_line":473,"language":"py","signature":"FUZZY_THRESHOLD: float = 0.85","params":[],"returns":"float","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_extraction.py","members":[],"inferred_raises":[],"returns_value":null,"value":"0.85","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
