{"uid":"estorides_core/entity_resolution.py::canonical_id","name":"canonical_id","qualname":"canonical_id","kind":"function","file":"estorides_core/entity_resolution.py","line":246,"end_line":254,"language":"py","signature":"def canonical_id(etype: str, normalized: str) -> str","params":[{"name":"etype","annotation":"str","default":"","kind":"positional"},{"name":"normalized","annotation":"str","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Stable, content-addressed id for a normalised entity.","description":"Same ``(type, normalized)`` always yields the same id, so a canonical\nentity keeps its identity for as long as its normalised form is stable.\nThe persistent store additionally maps known aliases onto an existing\nid so a never-before-seen surface form still resolves to the same node.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/entity_resolution.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/ids.py::stable_id"],"called_by":[]}
