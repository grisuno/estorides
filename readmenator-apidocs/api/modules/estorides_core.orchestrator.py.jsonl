{"uid":"estorides_core/orchestrator.py::Orchestrator.run","name":"run","qualname":"Orchestrator.run","kind":"method","file":"estorides_core/orchestrator.py","line":190,"end_line":668,"language":"py","signature":"async def run(self, query: str, *, source_names: Optional[List[str]] = None, include_paid: bool = False, parallel: int = HTTP_MAX_PARALLEL, timeout: float = HTTP_TIMEOUT, deadline: float = RUN_DEADLINE, on_source_done: Optional[Any] = None, on_source_result: Optional[Any] = None, persist: bool = True, case_id: Optional[str] = None, passive_only: bool = False, proxy: Optional[str] = None) -> Dict[str, Any]","params":[{"name":"query","annotation":"str","default":"","kind":"positional"},{"name":"source_names","annotation":"Optional[List[str]]","default":"None","kind":"keyword_only"},{"name":"include_paid","annotation":"bool","default":"False","kind":"keyword_only"},{"name":"parallel","annotation":"int","default":"HTTP_MAX_PARALLEL","kind":"keyword_only"},{"name":"timeout","annotation":"float","default":"HTTP_TIMEOUT","kind":"keyword_only"},{"name":"deadline","annotation":"float","default":"RUN_DEADLINE","kind":"keyword_only"},{"name":"on_source_done","annotation":"Optional[Any]","default":"None","kind":"keyword_only"},{"name":"on_source_result","annotation":"Optional[Any]","default":"None","kind":"keyword_only"},{"name":"persist","annotation":"bool","default":"True","kind":"keyword_only"},{"name":"case_id","annotation":"Optional[str]","default":"None","kind":"keyword_only"},{"name":"passive_only","annotation":"bool","default":"False","kind":"keyword_only"},{"name":"proxy","annotation":"Optional[str]","default":"None","kind":"keyword_only"}],"returns":"Dict[str, Any]","decorators":[],"bases":[],"modifiers":["async"],"visibility":"public","doc":{"summary":"Run a full intelligence cycle.","description":"Returns a structured result.\n\n`deadline` is a hard wall-clock cap (seconds) for the whole fanout.\nAny source that hasn't responded by then is dropped and reported as\n\"deadline_exceeded\" so the run can never get stuck.\n\n`persist` (default True) writes the run to the persistent case\nstore and mirrors every entity/edge to the Kùzu graph. Set\nFalse for one-off ad-hoc queries (e.g. tests) where you don't\nwant the run to bloat the long-term memory.\n\n`case_id`, when supplied, makes this run append to an existing\ncase instead of opening a new one. The recursive pivot engine\nuses this so every hop of a cross-search lands in a single case.\n\n`on_source_result`, when supplied, is invoked with the shaped\nobservation dict the moment each source resolves, before the\nfan-out as a whole completes. This is what lets the UI populate\nprogressively instead of blocking on the slowest source.\n\n`passive_only` (default False) restricts the fan-out to sources\nwhose contact class is `none` — the target's own infrastructure is\nnever touched, not even by a third-party broker probe. Use this for\nbug-bounty scoping where a probe attributable to the operator's\nrecon window must not appear in the target's logs.\n\n`proxy`, when supplied (e.g. `socks5://127.0.0.1:9050` for Tor),\nroutes every outbound request through it so the queried brokers\nnever see the operator's real egress IP. Falls back to the\nenv-configured proxy pool when omitted.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/orchestrator.py::Orchestrator","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["estorides_core/async_client.py::AsyncClient.__init__","estorides_core/config.py::effective_proxies","estorides_core/entity_extraction.py::detect_query_type","estorides_core/entity_extraction.py::extract_from_json","estorides_core/entity_extraction.py::extract_structured","estorides_core/entity_extraction.py::merge","estorides_core/event_bus.py::get_bus","estorides_core/mitre_attack.py::all_techniques_for","estorides_core/mitre_attack.py::map_observations","estorides_core/recon_fusion.py::ReconFusionEngine.__init__","estorides_core/recon_fusion.py::ReconFusionEngine.classify","estorides_core/system_app_sources.py::is_system_app"],"called_by":["estorides_cli.py::cmd_run","estorides_web.py::create_app"]}
