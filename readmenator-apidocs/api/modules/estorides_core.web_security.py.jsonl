{"uid":"estorides_core/web_security.py","name":"web_security.py","qualname":"estorides_core/web_security.py","kind":"module","file":"estorides_core/web_security.py","line":1,"end_line":446,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"estorides_core.web_security ===========================","description":"Production-grade web hardening helpers used by the Flask app factory.\n\nResponsibilities\n----------------\n* Security headers on every response (CSP, X-Frame-Options, X-Content-Type-Options,\n  Referrer-Policy, Permissions-Policy, HSTS when behind TLS).\n* Optional CORS allowlist (the platform is a local single-user tool by default —\n  CORS is opt-in, not opt-out, so the default is a tight same-origin policy).\n* A defensive request-size guard that rejects oversized JSON / form bodies\n  before they reach a route handler (the rest of the app trusts `request.get_json()`\n  blindly).\n* A Werkzeug-debugger kill-switch. Production deployments must never expose the\n  interactive debugger console — this helper refuses to register routes when\n  the dev debugger is on, and logs the attempt at WARNING level.\n* A bearer-token auth gate (`require_auth`) for sensitive endpoints. When the\n  operator sets `ESTORIDES_AUTH_TOKEN`, the sensitive `/api/*` surface stops\n  trusting anonymous callers; the legitimate UI gets the token from a\n  `<meta name=\"estorides-auth-token\">` tag rendered into `index.html` and\n  includes it as a header on every fetch.\n\n  When `ESTORIDES_AUTH_TOKEN` is unset, the system **auto-generates** a random\n  64-hex-char token on startup and prints it to the terminal. This ensures API\n  abuse protection is always on — no login page needed, no explicit registration.\n\nWhy a dedicated module?\n-----------------------\nThe Flask app is built by `estorides_web.create_app()`. Keeping the hardening\nout of the factory means:\n  * unit tests can spin up an app with a stripped-down middleware set,\n  * the surface is one file to audit (CVE-2023-style header regressions),\n  * everything is policy-driven by env vars, not magic literals scattered\n      across route definitions.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["estorides_core/web_security.py::build_https_url","estorides_core/web_security.py::WebSecurityConfig","estorides_core/web_security.py::load_security_config","estorides_core/web_security.py::install_security","estorides_core/web_security.py::AUTH_HEADER","estorides_core/web_security.py::AUTH_COOKIE","estorides_core/web_security.py::AUTH_META","estorides_core/web_security.py::AUTH_HEADER_ALT","estorides_core/web_security.py::AUTO_GENERATED_TOKEN","estorides_core/web_security.py::make_auth_gate","estorides_core/web_security.py::AuthGate","estorides_core/web_security.py::require_auth","estorides_core/web_security.py::install_auth_gate","estorides_core/web_security.py::auto_generated_token"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"estorides_core/web_security.py::build_https_url","name":"build_https_url","qualname":"build_https_url","kind":"function","file":"estorides_core/web_security.py","line":58,"end_line":80,"language":"py","signature":"def build_https_url(public_host: str, path: str, query_string: bytes) -> str","params":[{"name":"public_host","annotation":"str","default":"","kind":"positional"},{"name":"path","annotation":"str","default":"","kind":"positional"},{"name":"query_string","annotation":"bytes","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Build a safe HTTPS redirect target from a trusted host and client path.","description":"The client controls ``path``/``query_string``, so they are treated as\nhostile (the standing doctrine: never trust user input). We parse the\nreconstructed URL and refuse to emit a Location header whose scheme is\nnot ``https`` or whose host differs from the configured ``public_host``.\nOn any mismatch we fall back to a bare host root, so a crafted ``//evil``\nor ``\\evil`` path can never become an open redirect.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/web_security.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["estorides_core/web_security.py::install_security"]}
{"uid":"estorides_core/web_security.py::WebSecurityConfig","name":"WebSecurityConfig","qualname":"WebSecurityConfig","kind":"class","file":"estorides_core/web_security.py","line":87,"end_line":134,"language":"py","signature":"class WebSecurityConfig","params":[{"name":"allow_origins","annotation":"tuple[str, ...]","default":"()","kind":"positional"},{"name":"allow_methods","annotation":"tuple[str, ...]","default":"('GET', 'POST', 'DELETE', 'OPTIONS')","kind":"positional"},{"name":"allow_headers","annotation":"tuple[str, ...]","default":"('Content-Type', 'Authorization')","kind":"positional"},{"name":"allow_credentials","annotation":"bool","default":"False","kind":"positional"},{"name":"max_content_length_bytes","annotation":"int","default":"16 * 1024 * 1024","kind":"positional"},{"name":"csp_policy","annotation":"str","default":"\"default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-hashes' https://unpkg.com; img-src 'self' data: https:; connect-src 'self' https://unpkg.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'\"","kind":"positional"},{"name":"hsts_enabled","annotation":"bool","default":"False","kind":"positional"},{"name":"hsts_max_age_seconds","annotation":"int","default":"31536000","kind":"positional"},{"name":"public_host","annotation":"str","default":"'localhost:5050'","kind":"positional"},{"name":"force_https","annotation":"bool","default":"False","kind":"positional"}],"returns":"","decorators":["dataclass(frozen=True)"],"bases":[],"modifiers":["dataclass"],"visibility":"public","doc":{"summary":"Resolved security policy for the Flask app.","description":"All fields are read from the environment at import time and frozen so\nthe policy cannot drift at runtime. Changing a knob requires a restart\n— the right call for a tool that mostly runs as a long-lived daemon.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"