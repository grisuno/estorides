{"uid":"estorides_core/ontology.py::SanctionsIndex","name":"SanctionsIndex","qualname":"SanctionsIndex","kind":"class","file":"estorides_core/ontology.py","line":96,"end_line":264,"language":"py","signature":"class SanctionsIndex","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"In-memory OFAC SDN index with 24h lazy refresh and single-flight load.","description":"The previous design (if any) likely fetched the list on every call\nor had no cache; the new design:\n\n  * First call to `entries()` blocks while the CSV is fetched.\n  * Subsequent calls within TTL return the cached snapshot.\n  * Concurrent calls during a load share the same in-flight\n    promise (single-flight) — never two concurrent fetches.\n  * If a refresh fails after the cache has gone stale, we keep\n    serving the previous snapshot rather than going blind.\n\nThe CSV is downloaded over HTTPS to a temp file, then loaded\ninto a normalised lookup. We never trust the file path in\nthe SDN_LOCAL_CACHE to be writable: on permission errors we\nlog a warning and fall back to in-memory only.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"estorides_core/ontology.py","members":["estorides_core/ontology.py::SanctionsIndex.__init__","estorides_core/ontology.py::SanctionsIndex.is_ready","estorides_core/ontology.py::SanctionsIndex.entries","estorides_core/ontology.py::SanctionsIndex.lookup","estorides_core/ontology.py::SanctionsIndex.lookup_crypto","estorides_core/ontology.py::SanctionsIndex.size"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
