{"uid":"estorides_core/observation_models.py","name":"observation_models.py","qualname":"estorides_core/observation_models.py","kind":"module","file":"estorides_core/observation_models.py","line":1,"end_line":191,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"estorides_core.observation_models ================================ Strict, versioned Pydantic v2 data contracts for the observation and entity records that flow through the engine.","description":"The engine historically modelled these as unvalidated ``Dict[str, Any]``\nbuilt inline in the orchestrator, so a missing field, a wrong-typed value, or\na hostile payload could be silently propagated into the fusion store, the\nknowledge graph, or the LLM analyst. These models are the schema-contract\nboundary: parsing a dict validates it up front, ``extra=\"forbid\"`` makes\nschema drift a loud, traceable failure, and ``to_legacy_dict()`` projects back\nto the exact shape the current in-process call sites consume.\n\nThe module is pure (no I/O, no network, no clock reads, no logging of field\ncontents) and runs in the single-process architecture mandated by\n``CLAUDE.md``: no Redis, no Celery, no FAISS, no OTLP collector.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["estorides_core/observation_models.py::MAX_STR_LEN","estorides_core/observation_models.py::MAX_VALUE_LEN","estorides_core/observation_models.py::MAX_URL_LEN","estorides_core/observation_models.py::SCHEMA_VERSION","estorides_core/observation_models.py::ObservationMeta","estorides_core/observation_models.py::Observation","estorides_core/observation_models.py::ObservedEntity","estorides_core/observation_models.py::RunResult"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
